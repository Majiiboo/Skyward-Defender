; Engine configuration file.
config_version=5

[application]
config/name="Skybound Defender"
config/description="Godot v1.0: Hub + battle, layered character, idle auto-aim. Gear/Modes/Quests/Store screens next, one at a time."
run/main_scene="res://hub.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=480
window/size/viewport_height=800
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://fonts/exo2_semibold.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
textures/vram_compression/import_etc2_astc=true
